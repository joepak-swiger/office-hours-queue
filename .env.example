# Public values safe for the browser
NEXT_PUBLIC_APP_NAME="Office Hours Queue"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-only values. Never expose these in client code.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Email provider. Use "console" for local development, "resend" for real email.
NOTIFICATION_PROVIDER="console"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
NOTIFICATION_FROM_EMAIL="Office Hours Queue <notifications@example.com>"

# Demo seed account. Change these before using with real data.
DEMO_PROFESSOR_EMAIL="demo.professor@example.com"
DEMO_PROFESSOR_PASSWORD="OfficeHoursDemo123!"
DEMO_PROFESSOR_NAME="Professor Minji Kang"
