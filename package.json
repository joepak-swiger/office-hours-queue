{
  "name": "office-hours-queue",
  "version": "0.1.0",
  "private": true,
  "description": "Office Hours Queue v0.1.0: appointments, live queue, QR links, notifications, and analytics for college office hours.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --test scripts/smoke-tests.mjs",
    "db:seed": "node scripts/seed-demo.mjs",
